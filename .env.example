# All pipeline work uses the configured cloud services.
NODE_ENV=development
PORT=8080
GCP_PROJECT_ID=
GCS_BUCKET=
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-3-flash-preview
LYRIA_MODEL=lyria-3-pro-preview
TREBLO_API_KEY=
TREBLO_API_BASE_URL=https://api.treblo.com/v1
TREBLO_MODEL=v3
TREBLO_POLL_INTERVAL_MS=5000
TREBLO_GENERATION_TIMEOUT_MS=900000
AGENT_SERVICE_URL=http://localhost:8081
AGENT_SERVICE_AUDIENCE=
AGENT_SERVICE_TOKEN=
FIRESTORE_PROJECTS_COLLECTION=dailies_projects
FIRESTORE_JOBS_COLLECTION=dailies_pipeline_jobs
PIPELINE_LEASE_SECONDS=60
PIPELINE_RECOVERY_PROJECT_ID=
CORS_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=
# Leave both blank to use this API's own Google sign-in (api/src/googleSignIn.ts).
# Set only for a real IAP-fronted production ingress, which handles sign-in itself.
VITE_GOOGLE_SIGN_IN_URL=
VITE_SIGN_OUT_URL=
# Real Google sign-in for deployments with no IAP-fronted ingress (e.g. local/dev).
# Create an OAuth client (type: Web application) in Google Cloud Console and add
# GOOGLE_SIGN_IN_REDIRECT_URI to its authorized redirect URIs.
GOOGLE_SIGN_IN_CLIENT_ID=
GOOGLE_SIGN_IN_CLIENT_SECRET=
GOOGLE_SIGN_IN_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
GOOGLE_SIGN_IN_SUCCESS_URL=http://localhost:5173/studio/
# Generate with: openssl rand -base64 32
SESSION_SECRET=
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=true
CLICKHOUSE_VERIFY=true
CLICKHOUSE_MCP_URL=
CLICKHOUSE_MCP_AUTH_TOKEN=
CLICKHOUSE_INGEST_USER=
CLICKHOUSE_INGEST_PASSWORD=
INGESTION_SERVICE_TOKEN=
INGESTION_SERVICE_URL=http://localhost:8082
INGESTION_SERVICE_AUDIENCE=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:8080/api/youtube/callback
YOUTUBE_OAUTH_SUCCESS_URL=http://localhost:5173/studio/
# Generate with: openssl rand -base64 32
YOUTUBE_TOKEN_ENCRYPTION_KEY=
FIRESTORE_YOUTUBE_CONNECTIONS_COLLECTION=dailies_youtube_connections
FIRESTORE_YOUTUBE_STATES_COLLECTION=dailies_youtube_oauth_states
YOUTUBE_START_DATE=2006-01-01
YOUTUBE_VIDEO_LIMIT=10
